# ---- 4. Função para detectar Pareto (minimização) ----
is_pareto <- function(mat){
n <- nrow(mat)
pareto <- rep(TRUE, n)
for(i in 1:n){
for(j in 1:n){
if(all(mat[j,] <= mat[i,]) && any(mat[j,] < mat[i,])){
pareto[i] <- FALSE
break
}
}
}
return(pareto)
}
dados$Pareto <- is_pareto(as.matrix(dados))
